---
import { css } from "../../../styled-system/css";
import { hstack } from "../../../styled-system/patterns";
import { getLatestCommit } from "../../utils/git.ts";
import type { MainDictionary } from "../../i18n/main/en.ts";

interface Props {
  lang: string;
  dict: MainDictionary;
}

const { lang, dict } = Astro.props;

const commit = getLatestCommit();
---

{
  commit && (
    <a
      href={`https://github.com/youphenrique/phenrique.me/commit/${commit.sha}`}
      target="_blank"
      rel="noopener noreferrer"
      title={commit.shortSha}
      data-latest-commit
      data-date={commit.date}
      data-lang={lang}
      class={
        hstack({ gap: 1.5 }) +
        " " +
        css({
          fontSize: "xs",
          fontWeight: "medium",
          color: "text.muted",
          fontFamily: "GeistMono, 'Geist Mono'",
          transition: "color 0.15s ease-in-out",
          _hover: { color: "text.primary" },
        })
      }
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        class={css({ flexShrink: 0 })}
      >
        <path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z" />
      </svg>
      <span>
        {dict.footer["latest-commit"]} <time datetime={commit.date}>{commit.date.slice(0, 10)}</time>:
      </span>
      <span class={css({ color: "status.success" })}>+{commit.additions}</span>
      <span class={css({ color: "status.danger" })}>-{commit.deletions}</span>
    </a>
  )
}

<script>
  const DIVISIONS: [Intl.RelativeTimeFormatUnit, number][] = [
    ["second", 60],
    ["minute", 60],
    ["hour", 24],
    ["day", 7],
    ["week", 4.34524],
    ["month", 12],
    ["year", Number.POSITIVE_INFINITY],
  ];

  function relativeTime(date: Date, lang: string): string {
    const formatter = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
    let delta = (date.getTime() - Date.now()) / 1000;

    for (const [unit, amount] of DIVISIONS) {
      if (Math.abs(delta) < amount) return formatter.format(Math.round(delta), unit);
      delta /= amount;
    }

    return formatter.format(Math.round(delta), "year");
  }

  document.querySelectorAll<HTMLElement>("[data-latest-commit]").forEach((element) => {
    const timeElement = element.querySelector("time");
    const isoDate = element.dataset.date;

    if (!timeElement || !isoDate) return;

    const date = new Date(isoDate);

    if (Number.isNaN(date.getTime())) return;

    timeElement.textContent = relativeTime(date, element.dataset.lang || "en");
  });
</script>
