---
import { MarkdownDocument } from "@comark/react";

import { dictionaryFor, parseContent } from "../../utils/comark";
import { flattenToc, TOC_MIN_ENTRIES } from "../../utils/toc";
import { createProseComponents } from "./prose";
import TocRail from "./toc/toc-rail.astro";
import TocSheet from "./toc/toc-sheet.tsx";

interface Props {
  /**
   * Raw markdown body, e.g. `entry.body` from a content collection. Optional
   * because the loader types it as such — an entry with no body renders nothing.
   */
  body: string | undefined;
  /** Classes for the wrapper element — typically `prose`, the long-form layer. */
  class?: string;
  /**
   * Drives copy that the pipeline injects rather than the author writing it:
   * the footnote heading, the table's accessible name, callout labels. Falls
   * back to the page's own locale.
   */
  locale?: string;
  /**
   * Adds a table of contents built from the document's `h2` and `h3` headings:
   * a tick rail at the viewport edge on wide pointer screens, a reading pill
   * everywhere else. Skipped when the document has fewer than
   * `TOC_MIN_ENTRIES` headings.
   */
  toc?: boolean;
}

const { body, class: className, locale, toc = false } = Astro.props;
const resolvedLocale = locale ?? Astro.currentLocale ?? "en";

// Parsed here rather than inside the island: `MarkdownDocument` is synchronous,
// so there is no Suspense boundary and nothing to hydrate. Deliberately no
// `client:*` directive — this compiles to static HTML.
const document = body === undefined ? null : await parseContent(body, resolvedLocale);
const components = createProseComponents(resolvedLocale);

const tocEntries = toc && document !== null ? flattenToc(document.meta.toc) : [];
const tocLabel = dictionaryFor(resolvedLocale)["toc-label"];
---

{document !== null && <MarkdownDocument value={document} components={components} className={className} />}
{
  tocEntries.length >= TOC_MIN_ENTRIES && (
    <>
      <TocRail entries={tocEntries} label={tocLabel} />
      {/* The inverse of the rail's media query: hydrated only where the rail is not drawn. */}
      <TocSheet client:media="not all and (min-width: 80rem) and (hover: hover)" entries={tocEntries} label={tocLabel} />
    </>
  )
}
