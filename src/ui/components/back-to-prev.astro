---
import { css } from "../../../styled-system/css";

interface Props {
  href: string;
  /** Accessible name and tooltip. The button shows only an icon, so this is the
      only place its purpose is spelled out. */
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  title={label}
  class={css({
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    w: 9,
    h: 9,
    borderRadius: "full",
    bg: "bg.raised",
    color: "text.muted",
    transition: "color 0.15s ease-in-out, background-color 0.15s ease-in-out",
    _hover: { bg: "bg.raisedHover", color: "text.primary" },
    _focusVisible: {
      color: "text.primary",
      outline: "2px solid token(colors.border.focus)",
      outlineOffset: "2px",
    },
  })}
>
  <!-- lucide `undo-2` -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M9 14 4 9l5-5"></path>
    <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path>
  </svg>
</a>
