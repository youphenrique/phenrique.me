---
import { ClientRouter } from "astro:transitions";
import { SITE } from "../../consts.ts";
import { DEFAULT_LOCALE, matchTrailingSlash, type Alternates, type Locale } from "../../utils/i18n-routes.ts";
import { markdownPath } from "../../utils/markdown/routes.ts";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Locale of the page, for `og:locale` and to pick `x-default`'s target. */
  locale?: Locale;
  /**
   * Every locale's address for this page. One entry — or none — means the page
   * has no translation, and no `hreflang` links are emitted: a self-referencing
   * alternate on its own tells a crawler nothing it did not already know.
   */
  alternates?: Alternates;
  /** `article` on a post, so the card renders as one. */
  ogType?: "website" | "article";
  publishedTime?: Date;
  /** Structured data for this page, serialised into a `ld+json` script. */
  jsonLd?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  // The site-wide card. `linkbio-layout.astro` already points here; `head.astro`
  // pointed at `/nano.png`, a file that has never existed in `public/`, so every
  // page shipped an `og:image` that 404s.
  image = "/images/opengraph-image.png",
  locale = DEFAULT_LOCALE,
  alternates,
  ogType = "website",
  publishedTime,
  jsonLd,
} = Astro.props;

const OG_LOCALES: Record<Locale, string> = { en: "en_US", pt: "pt_BR" };

/**
 * A bare "Work" is an ambiguous browser tab and a weak search result, so the
 * site name is appended — but only where it fits. Google truncates a title
 * around 60 characters, and the suffix costs 17, so a title already at this
 * length would be pushed through the cut by the very thing meant to help it.
 * `/about`'s tagline is 59 characters and opts out on its own this way, with no
 * per-page special case.
 */
const SUFFIX_AT_MOST = 45;

const pageTitle = title.length >= SUFFIX_AT_MOST || title.includes(SITE.NAME) ? title : `${title} | ${SITE.NAME}`;

// Alternates are matched to the canonical's trailing-slash shape so the two
// never describe the same page two ways.
const alternateLinks = Object.entries(alternates ?? {}).map(([lang, path]) => ({
  lang,
  href: new URL(matchTrailingSlash(path, Astro.url.pathname), Astro.site).href,
}));

const hreflangLinks = alternateLinks.length > 1 ? alternateLinks : [];

// `x-default` points at the default locale, which is the version served to a
// reader whose language matches neither.
const xDefault = hreflangLinks.find((link) => link.lang === DEFAULT_LOCALE)?.href;

/**
 * The plain-Markdown twin of this page, when it has one. Announced the way the
 * feed is: an agent that can use the Markdown finds it from the HTML, without
 * having to guess that appending `.md` is a convention here.
 */
const markdownHref = markdownPath(Astro.url.pathname);

const blobBase = import.meta.env.PUBLIC_VERCEL_BLOB_STORAGE_URL ?? "";
const defaultFavicon = blobBase ? `${blobBase}/me.website.webp` : "/images/me.website.webp";
const darkFavicon = defaultFavicon;
const lightFavicon = blobBase ? `${blobBase}/me-2.website.webp` : "/images/me-2.website.webp";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link id="favicon-dark" rel="icon" type="image/webp" href={darkFavicon} data-src={darkFavicon} media="(prefers-color-scheme: dark)" />
<link id="favicon-light" rel="icon" type="image/webp" href={lightFavicon} data-src={lightFavicon} media="(prefers-color-scheme: light)" />
<link id="favicon-default" rel="icon" href={defaultFavicon} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate languages -->
{hreflangLinks.map((link) => <link rel="alternate" hreflang={link.lang} href={link.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE.NAME} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{
  alternateLinks
    .filter((link) => link.lang !== locale)
    .map((link) => <meta property="og:locale:alternate" content={OG_LOCALES[link.lang as Locale]} />)
}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

{
  jsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  )
}

<ClientRouter />

<!-- RSS Link -->
<link rel="alternate" type="application/rss+xml" title={SITE.NAME} href={new URL("rss.xml", Astro.site)} />

<!-- Markdown version of this page, for agents -->
{markdownHref && <link rel="alternate" type="text/markdown" href={new URL(markdownHref, Astro.site)} />}

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

  document.addEventListener("astro:before-swap", (e) =>
    [...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll("link[as='font']")].forEach((link) =>
      link.remove(),
    ),
  );
</script>

<script is:inline>
  function init() {
    preloadTheme();
    onScroll();
    animate();

    const lightThemeButton = document.getElementById("light-theme-button");
    lightThemeButton?.addEventListener("click", () => {
      localStorage.setItem("theme", "light");
      toggleTheme(false);
    });

    const darkThemeButton = document.getElementById("dark-theme-button");
    darkThemeButton?.addEventListener("click", () => {
      localStorage.setItem("theme", "dark");
      toggleTheme(true);
    });

    const systemThemeButton = document.getElementById("system-theme-button");
    systemThemeButton?.addEventListener("click", () => {
      localStorage.setItem("theme", "system");
      toggleTheme(window.matchMedia("(prefers-color-scheme: dark)").matches);
    });

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
      if (localStorage.theme === "system" || !localStorage.theme) {
        toggleTheme(event.matches);
      }
    });

    document.addEventListener("scroll", onScroll);
    onScroll();
  }

  function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add("show");
      }, index * 150);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add("scrolled");
    } else {
      document.documentElement.classList.remove("scrolled");
    }
  }

  function toggleTheme(dark) {
    const css = document.createElement("style");

    css.appendChild(
      document.createTextNode(
        `* {
             -webkit-transition: none !important;
             -moz-transition: none !important;
             -o-transition: none !important;
             -ms-transition: none !important;
             transition: none !important;
          }
        `,
      ),
    );

    document.head.appendChild(css);

    // Both classes are kept in sync. `light` gates the paper grain in
    // global.css, so leaving it behind when switching to dark paints the
    // texture over the ink canvas.
    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.classList.toggle("light", !dark);

    // Update active favicon to match the selected theme
    const faviconDark = document.getElementById("favicon-dark");
    const faviconLight = document.getElementById("favicon-light");
    const faviconDefault = document.getElementById("favicon-default");
    const activeFavicon = dark ? faviconDark?.dataset.src : faviconLight?.dataset.src;
    if (activeFavicon) {
      if (faviconDefault) faviconDefault.href = activeFavicon;
      if (faviconDark) faviconDark.href = activeFavicon;
      if (faviconLight) faviconLight.href = activeFavicon;
    }

    // window.getComputedStyle(css).opacity;
    document.head.removeChild(css);

    if (typeof window.__themeToggleCallback === "function") {
      window.__themeToggleCallback();
    }
  }

  function preloadTheme() {
    const userTheme = localStorage.theme;

    if (userTheme === "light" || userTheme === "dark") {
      toggleTheme(userTheme === "dark");
    } else {
      toggleTheme(window.matchMedia("(prefers-color-scheme: dark)").matches);
    }
  }

  document.addEventListener("DOMContentLoaded", () => init());
  document.addEventListener("astro:after-swap", () => init());

  preloadTheme();
</script>
