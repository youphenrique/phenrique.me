---
import { type CollectionEntry, getCollection } from "astro:content";

import PostView from "../../views/writing/post.astro";
import { publishedPosts } from "../../utils/content";
import dict from "../../i18n/writing/en";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("writing"), "en");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"writing">;
---

<PostView post={Astro.props} indexHref="/writing" dict={dict} />
