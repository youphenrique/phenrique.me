---
import { getEntry } from "astro:content";
import LongformView from "../../views/longform/view.astro";

const entry = await getEntry("aiPages", "pt");

if (entry === undefined) {
  return Astro.redirect("/404");
}
---

<LongformView title={entry.data.title} description={entry.data.description} body={entry.body} locale="pt" />
