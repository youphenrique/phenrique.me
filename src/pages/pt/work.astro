---
import { getEntry } from "astro:content";

import dict from "../../i18n/work/pt";
import WorkView from "../../views/work/view.astro";

const workEntry = await getEntry("work", Astro.currentLocale ?? "pt");

if (workEntry === undefined) {
  return Astro.redirect("/404");
}
---

<WorkView dict={dict} page={workEntry} />
