---
import { getEntry } from "astro:content";

import dict from "../../i18n/work/pt";
import WorkView from "../../views/work/view.astro";

const workPageEntry = await getEntry("workPages", Astro.currentLocale ?? "pt");

if (workPageEntry === undefined) {
  return Astro.redirect("/404");
}
---

<WorkView dict={dict} page={workPageEntry} />
