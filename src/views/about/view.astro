---
import { css } from "../../../styled-system/css";
import MainLayout from "../../layouts/main-layout.astro";
import Container from "../../ui/common/container.astro";
import Markdown from "../../ui/common/markdown.astro";

interface Props {
  title: string;
  bioImageResource: string;
  /** Raw markdown body for the page's prose. */
  body: string | undefined;
}
---

<MainLayout title="Home" description="Paulo Henrique's personal website" lang={Astro.currentLocale!}>
  <Container styles={css.raw({ py: { base: 32, sm: 44, "2xl": 52 } })}>
    <h1
      class={"fraunces-font " + css({
        fontSize: { base: "4xl", md: "5xl" },
        color: "text.primary",
        textAlign: "center",
        lineHeight: "1.1",
      })}
    >
      {Astro.props.title}
    </h1>
    <Markdown body={Astro.props.body} class={"prose-ui antialiased " + css({ mt: 10, maxW: "xl" })} />
  </Container>
</MainLayout>
