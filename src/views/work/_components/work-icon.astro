---
// Lucide glyphs inlined by hand, matching `nav-icon.astro` — the icon set stays
// dependency-free. Paths are verbatim from lucide-icons (MIT), 24x24 grid.
//
// The six `highlights` names are the enum `workPages` validates against, so a
// content file cannot name a glyph that does not exist here.
export type WorkIconName = "code" | "layers" | "lightbulb" | "graduation" | "heart" | "users";

interface Props {
  name: WorkIconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: iconClass } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={iconClass}
>
  {/* code-xml */}
  {
    name === "code" ? (
      <>
        <path d="m18 16 4-4-4-4" />
        <path d="m6 8-4 4 4 4" />
        <path d="m14.5 4-5 16" />
      </>
    ) : null
  }

  {/* layers */}
  {
    name === "layers" ? (
      <>
        <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
        <path d="M2 12.18a1 1 0 0 0 .6.91l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 .6-.92" />
        <path d="M2 17.18a1 1 0 0 0 .6.91l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 .6-.92" />
      </>
    ) : null
  }

  {/* lightbulb */}
  {
    name === "lightbulb" ? (
      <>
        <path d="M9 18h6" />
        <path d="M10 22h4" />
        <path d="M15.09 14c.18-.57.66-1 1.07-1.41A6 6 0 1 0 7.83 12.5c.48.47 1 1 1.18 1.5" />
        <path d="M9 14h6v1a3 3 0 0 1-6 0z" />
      </>
    ) : null
  }

  {/* graduation-cap */}
  {
    name === "graduation" ? (
      <>
        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
        <path d="M22 10v6" />
        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
      </>
    ) : null
  }

  {/* heart */}
  {
    name === "heart" ? (
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z" />
    ) : null
  }

  {/* users */}
  {
    name === "users" ? (
      <>
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <path d="M16 3.128a4 4 0 0 1 0 7.744" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
        <circle cx="9" cy="7" r="4" />
      </>
    ) : null
  }

</svg>
