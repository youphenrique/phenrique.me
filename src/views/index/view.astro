---
import { css } from "../../../styled-system/css";
import MainLayout from "../../layouts/main-layout.astro";
import Container from "../../ui/common/container.astro";
import PauloHenrique from "../../ui/common/paulo-henrique.astro";

interface Props {
  title: string;
}
---

<MainLayout title="Home" description="Paulo Henrique's personal website" lang={Astro.currentLocale!}>
  <Container styles={css.raw({ py: { base: 32, sm: 44 } })}>
    <div
      class={css({
        zIndex: 0,
        pointerEvents: "none",
        background: "radial-gradient(#ffffff08 0%, #0000 70%)",
        width: { base: "full", md: "600px" },
        height: "400px",
        position: "absolute",
        top: 0,
        left: "50%",
        transform: "translate(-50%)",
      })}
    >
    </div>
    <h1
      class={css({
        mt: 4,
        maxW: { base: "260px", md: "340px" },
        color: "clr_neutral_900_50",
      })}
    >
      <PauloHenrique label={Astro.props.title} />
    </h1>
    <div class={"prose-ui antialiased " + css({ mt: 10, maxW: "xl" })}>
      <slot />
    </div>
  </Container>
</MainLayout>
