---
import { getCollection } from "astro:content";
import { css } from "../../../styled-system/css";
import { hstack } from "../../../styled-system/patterns";
import MainLayout from "../../layouts/main-layout.astro";
import Container from "../../ui/components/container.astro";
import Markdown from "../../ui/components/markdown.astro";

interface Props {
  title: string;
  /** Raw markdown body for the page's intro copy. */
  body: string | undefined;
}

const allSocialLinks = await getCollection("socialLinks");
const socialLinks = allSocialLinks.filter((link) => link.data.icon !== undefined);
const isPortuguese = Astro.currentLocale === "pt";
---

<MainLayout title="Home" description="Paulo Henrique's personal website" lang={Astro.currentLocale ?? "en"}>
  <Container styles={css.raw({ py: { base: 32, sm: 44 } })}>
    <div
      class={css({
        zIndex: 0,
        pointerEvents: "none",
        background: "radial-gradient(token(colors.bg.bloom) 0%, transparent 70%)",
        width: { base: "full", md: "600px" },
        height: "400px",
        position: "absolute",
        top: 0,
        left: "50%",
        transform: "translate(-50%)",
      })}
    >
    </div>
    <h1
      class={"instrument-serif " +
        css({
          mt: 4,
          color: "text.primary",
          fontSize: { base: "4xl", md: "5xl" },
          fontWeight: "normal",
          fontStyle: "italic",
          letterSpacing: "-0.06em",
          lineHeight: "0.9",
        })}
    >
      {Astro.props.title}
    </h1>
    <Markdown body={Astro.props.body} class={"prose " + css({ mt: 10, maxW: "xl" })} />
    <div class={hstack({ gap: { base: 6, lg: 4 }, mt: 12 })}>
      {
        socialLinks.map((item) => (
          <a
            target="_blank"
            href={item.data.link}
            aria-label={
              isPortuguese
                ? `Visitar Paulo Henrique no ${item.data.name} (abre em uma nova aba)`
                : `Visit Paulo Henrique on ${item.data.name} (opens in a new tab)`
            }
            rel="noopener noreferrer"
            set:html={item.data.icon}
            class={css({
              w: 4,
              color: "text.muted",
              display: "block",
              "& svg": { w: "full", h: "auto" },
              "& svg path": {
                transition: "fill 0.15s ease-in-out",
              },
              "& svg:hover path": {
                fill: "text.primary",
              },
            })}
          />
        ))
      }
    </div>
  </Container>
</MainLayout>
