---
import { getCollection } from "astro:content";
import { css } from "../../../styled-system/css";
import { hstack } from "../../../styled-system/patterns";
import MainLayout from "../../layouts/main-layout.astro";
import Container from "../../ui/common/container.astro";
import PauloHenrique from "../../ui/common/paulo-henrique.astro";

interface Props {
  title: string;
}

const allSocialLinks = await getCollection("socialLinks");
const socialLinks = allSocialLinks.filter((link) => link.data.icon !== undefined);
---

<MainLayout title="Home" description="Paulo Henrique's personal website" lang={Astro.currentLocale!}>
  <Container styles={css.raw({ py: { base: 32, sm: 44 } })}>
    <div
      class={css({
        zIndex: 0,
        pointerEvents: "none",
        background: "radial-gradient(token(colors.bg.bloom) 0%, transparent 70%)",
        width: { base: "full", md: "600px" },
        height: "400px",
        position: "absolute",
        top: 0,
        left: "50%",
        transform: "translate(-50%)",
      })}
    >
    </div>
    <h1
      class={css({
        mt: 4,
        maxW: { base: "260px", md: "340px" },
        color: "text.primary",
      })}
    >
      <PauloHenrique label={Astro.props.title} />
    </h1>
    <div class={"prose-ui antialiased " + css({ mt: 10, maxW: "xl" })}>
      <slot />
    </div>
    <div class={hstack({ gap: { base: 6, lg: 4 }, mt: 12 })}>
      {
        socialLinks.map((item) => (
          <a
            target="_blank"
            href={item.data.link}
            title={item.data.name}
            rel="noopener noreferrer"
            set:html={item.data.icon}
            class={css({
              w: 4,
              color: "text.muted",
              display: "block",
              "& svg": { w: "full", h: "auto" },
              "& svg path": {
                transition: "fill 0.15s ease-in-out",
              },
              "& svg:hover path": {
                fill: "text.primary",
              },
            })}
          />
        ))
      }
    </div>
  </Container>
</MainLayout>
