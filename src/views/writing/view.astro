---
import { getCollection } from "astro:content";

import MainLayout from "../../layouts/main-layout.astro";
import Container from "../../ui/components/container.astro";
import { vstack } from "../../../styled-system/patterns";
import { css } from "../../../styled-system/css";
import PostCard from "./_components/post-card.astro";
import EmptyState from "./_components/empty-state.astro";
import { publishedPosts } from "../../utils/content";
import type { WritingDictionary } from "../../i18n/writing/types.ts";

interface Props {
  title: string;
  description: string;
  dict: WritingDictionary;
}

const dateFormatter = new Intl.DateTimeFormat(Astro.currentLocale, {
  day: "numeric",
  month: "short",
  year: "numeric",
  // Dates are authored as plain YAML days and parsed as UTC midnight; formatting
  // in the build machine's zone would render the previous day west of Greenwich.
  timeZone: "UTC",
});

const posts = publishedPosts(await getCollection("writing"), (Astro.currentLocale ?? "en") as "en" | "pt");
---

<MainLayout title={Astro.props.title} description={Astro.props.description} lang={Astro.currentLocale ?? "en"}>
  <Container>
    <div class={vstack({ mt: 32, alignItems: "stretch", gap: 8 })}>
      <h1
        class={"fraunces-font " +
          css({
            fontSize: "4xl",
            fontWeight: "semibold",
            color: "text.primary",
          })}
      >
        {Astro.props.dict["page-title"]}
      </h1>
    </div>
    {
      posts.length === 0 ? (
        <div class={css({ mt: 8, mb: 20 })}>
          <EmptyState
            title={Astro.props.dict["empty-state"].title}
            description={Astro.props.dict["empty-state"].description}
          />
        </div>
      ) : (
        <ul class={vstack({ mt: 8, mb: 20, alignItems: "stretch", gap: 3 })}>
          {posts.map((post) => (
            <li>
              <PostCard
                href={post.data.locale === "pt" ? `/pt/writing/${post.data.slug}` : `/writing/${post.data.slug}`}
                title={post.data.title}
                date={dateFormatter.format(post.data.date)}
                dateTime={post.data.date.toISOString()}
                description={post.data.description}
              />
            </li>
          ))}
        </ul>
      )
    }
  </Container>
</MainLayout>
