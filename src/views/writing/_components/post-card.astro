---
import { css } from "../../../../styled-system/css";

interface Props {
  href: string;
  title: string;
  date: string;
  dateTime: string;
  description: string;
}

const { href, title, date, dateTime, description } = Astro.props;

const transition = {
  transitionDuration: "250ms",
  transitionTimingFunction: "ease-in-out",
  _motionReduce: { transitionDuration: "0ms" },
} as const;
---

<a
  href={href}
  class={`group ${css({
    display: "flex",
    alignItems: "flex-start",
    gap: 3.5,
    py: 3,
    px: 4,
    borderRadius: "xl",
    transitionProperty: "background-color",
    ...transition,
    _hover: { backgroundColor: "bg.hover" },
    _focusVisible: {
      backgroundColor: "bg.hover",
      outline: "2px solid token(colors.border.accent)",
      outlineOffset: "2px",
    },
  })}`}
>
  <span
    class={css({
      display: "grid",
      flexShrink: 0,
      placeItems: "center",
      w: 10,
      h: 10,
      borderRadius: "xl",
      border: "1px solid",
      borderColor: "border.hairline",
      backgroundColor: "bg.raised",
      color: "text.faint",
    })}
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 3h7l5 5v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path>
      <path d="M13 3v5h5"></path>
      <g
        class={css({
          opacity: 0,
          transitionProperty: "opacity",
          ...transition,
          _groupHover: { opacity: 1 },
          _groupFocusVisible: { opacity: 1 },
        })}
      >
        <path d="M8.5 12.5h7"></path>
        <path d="M8.5 15.5h7"></path>
        <path d="M8.5 18.5h4"></path>
      </g>
    </svg>
  </span>
  <span class={css({ display: "flex", flexDirection: "column", minWidth: 0, flex: 1 })}>
    <span class={css({ fontSize: "md", fontWeight: "medium", color: "text.primary", lineHeight: "1.5" })}>
      {title}
    </span>
    {
      /*
      Always rendered, at every card. The description is what tells a reader
      whether to open the post, so it is not hover-only: a pointer is the one
      input that can reveal it, and it leaves touch and scanning with a bare
      title. Clamping it also fixes the card's height, which is what keeps
      hovering down the list from pushing the next card out from under the
      cursor.
    */
    }
    <span
      class={css({
        // Two lines below `sm`, one above. A single line at 375px carries about
        // four words of description, which is not enough to decide on a post;
        // the wider card fits a useful clamp on one. Either way the height is
        // fixed at render, so nothing moves under the cursor.
        display: { base: "-webkit-box", sm: "block" },
        boxOrient: "vertical",
        lineClamp: "2",
        overflow: "hidden",
        textOverflow: "ellipsis",
        whiteSpace: { base: "normal", sm: "nowrap" },
        fontSize: "sm",
        lineHeight: "1.5",
        color: "text.muted",
      })}
    >
      <time datetime={dateTime}>{date}</time>
      <span aria-hidden="true">&nbsp;·&nbsp;</span>
      {description}
    </span>
  </span>
</a>
