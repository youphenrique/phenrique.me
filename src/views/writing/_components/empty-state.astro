---
import { css } from "../../../../styled-system/css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div
  class={css({
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    textAlign: "center",
    py: { base: 16, sm: 24 },
    px: 4,
  })}
>
  {
    /*
    The inner tile is the post card's icon well at a larger size — same
    `bg.raised` on a hairline border, same `text.faint` glyph — so the page a
    reader lands on before the first post is published is visibly made of the
    same part as the list that will replace it. The outer ring is empty on
    purpose: it reads as a frame waiting to be filled.
  */
  }
  <div
    class={css({
      display: "grid",
      placeItems: "center",
      w: 20,
      h: 20,
      borderRadius: "2xl",
      border: "1px solid",
      borderColor: "border.hairline",
    })}
  >
    <div
      class={css({
        display: "grid",
        placeItems: "center",
        w: 14,
        h: 14,
        borderRadius: "xl",
        border: "1px solid",
        borderColor: "border.subtle",
        backgroundColor: "bg.raised",
        color: "text.faint",
      })}
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
        <path d="M16 8 2 22"></path>
        <path d="M17.5 15H9"></path>
      </svg>
    </div>
  </div>
  <h2
    class={`fraunces-font ${css({
      mt: 6,
      fontSize: "2xl",
      fontWeight: "semibold",
      lineHeight: "1.2",
      letterSpacing: "-0.015em",
      textWrap: "balance",
      color: "text.primary",
    })}`}
  >
    {title}
  </h2>
  <p
    class={css({
      mt: 2.5,
      maxW: "26rem",
      fontSize: "sm",
      lineHeight: 1.6,
      textWrap: "pretty",
      color: "text.muted",
    })}
  >
    {description}
  </p>
</div>
